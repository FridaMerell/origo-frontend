# Copy to `.env` and fill in. All values here are read in app/lib/config.ts,
# app/api/upload/route.ts and app/api/files/route.ts.

# --- Required ---

# Vercel Blob read/write token. Backs file uploads and downloads.
# Local: run `vercel env pull` or copy from Vercel > Storage > your Blob store.
BLOB_READ_WRITE_TOKEN=

# --- Optional (have defaults in app/lib/config.ts) ---

# Base URL of the origo-api backend.
# Default: http://api.origo.test:8000
ORIGO_API_URL=

# Shared parent domain for the session cookie, so it is sent to every
# subdomain (verso, flux, tempus, apsis). Leave unset to scope the cookie to
# the exact host that set it.
# Default: .origo.test
ORIGO_COOKIE_DOMAIN=

# Version string shown in the Verso sidebar / Flux toolbar. Public — inlined
# into the client bundle at build time. On Vercel you can set it to
# $VERCEL_GIT_COMMIT_SHA for a per-deploy value.
# Default: 0.0.1
NEXT_PUBLIC_ORIGO_VERSION=


# Google Maps API key.
# Required for any Google Maps integration.
# Default: (none)
GOOGLE_MAPS_API_KEY=