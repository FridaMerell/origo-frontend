# Copy to `.env` and fill in. All values here are read in app/lib/config.ts
# and app/lib/storage.ts.

# --- Required ---

# Cloudflare R2 (S3-compatible) storage for file uploads and downloads.
# The bucket must be private; files are served through /api/files.
# Create an API token under R2 > Manage API tokens (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Only if the bucket was created with a jurisdiction, e.g. "eu".
R2_JURISDICTION=

# --- Optional (have defaults in app/lib/config.ts) ---

# Base URL of the origo-api backend.
# Default: http://api.origo.test:8000
ORIGO_API_URL=

# Public API URL used by the browser for the direct BirdNET SSE connection.
# Must be set when the deployed API is on another subdomain. This value is
# embedded in the frontend bundle at build time.
NEXT_PUBLIC_ORIGO_API_URL=

# Shared parent domain for the session cookie, so it is sent to every
# subdomain (verso, flux, tempus, apsis, opus). Leave unset to scope the cookie to
# the exact host that set it.
# Default: .origo.test
ORIGO_COOKIE_DOMAIN=

# Version string shown in the Verso sidebar / Flux toolbar. Public — inlined
# into the client bundle at build time. On Vercel you can set it to
# $VERCEL_GIT_COMMIT_SHA for a per-deploy value.
# Default: 0.0.1
NEXT_PUBLIC_ORIGO_VERSION=


# Google Maps JavaScript API key. Public — inlined into the client bundle at
# build time. Enable the Maps JavaScript API, Places API and Directions API for
# the key, and restrict it by HTTP referrer. Used by the route planner.
# Default: (none)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
